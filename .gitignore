# ==============================================================================
# DepthWizard .gitignore
# ==============================================================================

# --- Python & Bytecode ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# --- Virtual Environments ---
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# --- Environment Variables & Secrets ---
.env
.env.*
!.env.example

# --- Local Databases ---
*.db
*.sqlite3
depthwizard.db

# --- Pipeline Storage & Outputs (Keep folder structure via .gitkeep) ---
uploads/*
!uploads/.gitkeep
outputs/*
!outputs/.gitkeep

# --- Machine Learning Model Weights & Checkpoint Caches ---
*.pt
*.pth
*.bin
*.onnx
*.safetensors
checkpoints/
.cache/
hf_models/

# --- Node / Frontend ---
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.oxlintrc.json
.npm/
.yarn/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Operating System & IDE Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

.idea/
.vscode/
*.swp
*.swo
*~
